{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hum",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CounterDO",
        "class_name": "CounterDO"
      }
    ]
  },
  "exports": {
    "CounterDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "queues": {
    "producers": [
      {
        "queue": "hum-queue",
        "binding": "QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "hum-queue",
        "max_batch_size": 10
      }
    ]
  }
}
